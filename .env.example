# Copy to .env (gitignored) and fill in. See docs/setup/zerodha.md.

# Zerodha Kite Connect app credentials (https://developers.kite.trade/)
KITE_API_KEY=
KITE_API_SECRET=

# Optional: where OpenTicker keeps its databases and encryption key.
# Defaults to ~/.openticker
# OPENTICKER_HOME=

# Optional: paper trading (the sandbox). Nothing is ever sent to the broker.
# Virtual capital, applied when sandbox funds are first created. Default 1,00,00,000.
# SANDBOX_STARTING_CAPITAL=
# SANDBOX_SLIPPAGE_TICKS=1        # ticks a fill without a bid/ask moves against the order
# Most one position may be worth, in rupees. Orders that reduce a position are never blocked.
# OPENTICKER_CAPITAL_CAP=

# Optional: where the REST API (openticker-serve) listens, host:port.
# Defaults to this machine only. Anything beyond loopback needs TLS in front.
# OPENTICKER_BIND=127.0.0.1:8750

# Optional: what one run of a hosted Python script may use (ADR 25). A script
# over its memory is killed; one out of CPU time is ended by the system.
# SCRIPT_MEMORY_LIMIT_MB=1024
# SCRIPT_CPU_SECONDS=3600

# Optional: agent jobs (ADR 29). openticker-serve runs your own coding agent,
# signed in as you, in labs/ to review a strategy (start_review). It gets a key
# that reads only that strategy, never these settings.
# OPENTICKER_AGENT_HARNESS=claude           # or codex
# OPENTICKER_AGENT_TIMEOUT_MINUTES=15
# OPENTICKER_AGENT_JOBS_PER_DAY=20
# OPENTICKER_AGENT_MAX_BUDGET_USD=          # Claude Code only; unset means no cap
# OPENTICKER_LABS_DIR=                      # default: labs/ in this checkout

# Optional: instruments openticker-serve streams live prices for, besides open
# sandbox positions. EXCHANGE:SYMBOL pairs separated by commas.
# OPENTICKER_WATCH=NSE:NIFTY 50,NSE:RELIANCE

# Optional notifications for orders and risk breaches. Configure any, all or none;
# every event is written to the local audit log regardless.

# Slack: create an Incoming Webhook (https://api.slack.com/messaging/webhooks)
# SLACK_WEBHOOK_URL=

# Email via any SMTP server (Resend, Amazon SES, Gmail app password, ...).
# Port 465 uses TLS directly; other ports upgrade with STARTTLS. Default 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=      # a sender address your provider has verified
# NOTIFY_EMAIL_TO=
