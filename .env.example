# Copy to .env (gitignored) and fill in. See docs/setup/zerodha.md.

# Zerodha Kite Connect app credentials (https://developers.kite.trade/)
KITE_API_KEY=
KITE_API_SECRET=

# Optional: where OpenTicker keeps its databases and encryption key.
# Defaults to ~/.openticker
# OPENTICKER_HOME=

# Optional: paper trading (the sandbox). Nothing is ever sent to the broker.
# Virtual capital, applied when sandbox funds are first created. Default 1,00,00,000.
# SANDBOX_STARTING_CAPITAL=
# Most one position may be worth, in rupees. Orders that reduce a position are never blocked.
# OPENTICKER_CAPITAL_CAP=

# Optional notifications for orders and risk breaches. Configure any, all or none;
# every event is written to the local audit log regardless.

# Slack: create an Incoming Webhook (https://api.slack.com/messaging/webhooks)
# SLACK_WEBHOOK_URL=

# Email via any SMTP server (Resend, Amazon SES, Gmail app password, ...).
# Port 465 uses TLS directly; other ports upgrade with STARTTLS. Default 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=      # a sender address your provider has verified
# NOTIFY_EMAIL_TO=
