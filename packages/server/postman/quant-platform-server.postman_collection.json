{
  "info": {
    "name": "Quant Platform",
    "description": "Unified REST API over ingest, quant, strategy, and execution. Set {{baseUrl}} to your running server (default http://localhost:8000).\n\nAuth: log in once under the Auth folder to get a session token, auto-stored in {{sessionToken}}. `Market > Get bars` and `Backtests > Run backtest` send it as a Bearer token — the server decodes it to know which provider to fetch from. Provider is picked at login, not per-symbol: whichever provider you logged in with serves any range not already cached in DuckDB.\n\nKite login is a real OAuth-style flow: open the login URL, sign in on Zerodha's own page, no key pasting. Groww login is work in progress — Groww has no published app-registration + redirect flow yet, so `/auth/groww/login` still requires pasting your own Groww api_key/secret. Use Kite for now.\n\nMarket bars and backtest bars are fetched on demand via DataEngine: a date range never seen before is fetched live from the logged-in provider and cached in DuckDB, a range already cached returns instantly with no provider call. `symbol` must be the provider's bare tradingsymbol (e.g. `RELIANCE`); `interval` must be a canonical string (`1d`, `1m`, `5m`, ... not a provider-specific string).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "runId", "value": "run-1" },
    { "key": "symbol", "value": "RELIANCE" },
    { "key": "fromTs", "value": "2026-06-08T00:00:00Z" },
    { "key": "toTs", "value": "2026-09-03T00:00:00Z" },
    { "key": "interval", "value": "1d" },
    { "key": "sessionToken", "value": "" },
    { "key": "kiteRequestToken", "value": "" },
    { "key": "growwApiKey", "value": "" },
    { "key": "growwTotpSecret", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Kite login URL",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/kite/login", "host": ["{{baseUrl}}"], "path": ["auth", "kite", "login"] }
          }
        },
        {
          "name": "Kite callback (exchange request_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('sessionToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/kite/callback?request_token={{kiteRequestToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "kite", "callback"],
              "query": [{ "key": "request_token", "value": "{{kiteRequestToken}}" }]
            }
          }
        },
        {
          "name": "Groww login (WIP — requires pasting your own Groww api_key/secret)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('sessionToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"{{growwApiKey}}\",\n  \"totp_secret\": \"{{growwTotpSecret}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/groww/login", "host": ["{{baseUrl}}"], "path": ["auth", "groww", "login"] }
          }
        }
      ]
    },
    {
      "name": "Backtests",
      "item": [
        {
          "name": "List strategies",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/strategies", "host": ["{{baseUrl}}"], "path": ["strategies"] }
          }
        },
        {
          "name": "Run backtest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy_name\": \"sma_crossover\",\n  \"symbols\": [\"{{symbol}}\"],\n  \"interval\": \"{{interval}}\",\n  \"from\": \"{{fromTs}}\",\n  \"to\": \"{{toTs}}\",\n  \"starting_cash\": 100000.0,\n  \"short_window\": 5,\n  \"long_window\": 20,\n  \"quantity\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/backtests", "host": ["{{baseUrl}}"], "path": ["backtests"] }
          }
        },
        {
          "name": "List runs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/backtests?page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["backtests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get trades for run",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/backtests/{{runId}}/trades?page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["backtests", "{{runId}}", "trades"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get metrics for run",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/backtests/{{runId}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["backtests", "{{runId}}", "metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Get positions for run",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/portfolio/{{runId}}/positions",
              "host": ["{{baseUrl}}"],
              "path": ["portfolio", "{{runId}}", "positions"]
            }
          }
        }
      ]
    },
    {
      "name": "Market",
      "item": [
        {
          "name": "Get bars",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sessionToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/market/bars?symbol={{symbol}}&from={{fromTs}}&to={{toTs}}&interval={{interval}}",
              "host": ["{{baseUrl}}"],
              "path": ["market", "bars"],
              "query": [
                { "key": "symbol", "value": "{{symbol}}" },
                { "key": "from", "value": "{{fromTs}}" },
                { "key": "to", "value": "{{toTs}}" },
                { "key": "interval", "value": "{{interval}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "OpenAPI schema",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"] }
          }
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/docs", "host": ["{{baseUrl}}"], "path": ["docs"] }
          }
        }
      ]
    }
  ]
}
